def insert(heap,value):
    heap.append(value)
    i = len(heap) - 1
    while i!=0:
        parent = (i - 1) // 2
        if heap[parent] >= heap[i]:
            break
        else:
            heap[parent], heap[i] = heap[i], heap[parent]
            i = parent
def delete_max(heap):
    if not heap:
        return None
    max_value = heap[0]
    heap[0] = heap[-1]
    heap.pop()
    i = 0
    while 2*i+1<len(heap):
        left = 2*i+1
        right = 2*i+2
        if right < len(heap) and heap[right] > heap[left]:
            larger_child = right
        else:
            larger_child = left
        if heap[i] >= heap[larger_child]:
            break
        else:
            heap[i], heap[larger_child] = heap[larger_child], heap[i]
            i = larger_child
    return max_value
def peek(heap):
    if not heap:
        return None
    else:
        return heap[0]
